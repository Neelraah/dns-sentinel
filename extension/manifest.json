{
  "manifest_version": 3,
  "name": "DNS Sentinel \u2014 Honeypot Monitor",
  "version": "1.1.0",
  "description": "Local-first browser request telemetry for DNS Sentinel.",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DNS Sentinel",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
